#pragma kernel CSClearGrid
#pragma kernel CSGenerateKeyValues
#pragma kernel CSBitonicSortLocal
#pragma kernel CSBitonicSortGlobal
#pragma kernel CSReorderParticles
#pragma kernel CSBuildGridOffsets
#pragma kernel CSDensityPressure
#pragma kernel CSForces
#pragma kernel CSIntegrate

struct Particle {
    float3 position;
    float3 velocity;
    float3 force;
    float density;
    float pressure;
    float lifetime;
};

RWStructuredBuffer<Particle> Particles;       
RWStructuredBuffer<Particle> ParticlesSorted; 

RWStructuredBuffer<uint2> GridKeyValues; 
RWStructuredBuffer<uint> GridCellStarts; 
RWStructuredBuffer<uint> GridCellEnds;  

RWStructuredBuffer<uint> ParticlesInBucketCount;

#define HASH_DIM 64  

uint numParticles;
uint sortedSize; 
int _BlockSize;
int _Stage;

float smoothingRadius;
float restDensity;
float gasConstant;
float viscosity;
float particleMass;
float3 gravity;
float3 boxSize;
float3 boxCenter;
float boundaryDamping;
float particleRadius;
float deltaTime;
float poly6;
float spikyGrad;
float viscLap;
float cellSize;

float4x4 bucketWorldToLocal;
float4x4 bucketLocalToWorld;
float bucketRadiusCS;
float bucketHeightCS;
float holeRadiusCS;
float3 holeLocalPos;
float3 bucketVelocity;

RWStructuredBuffer<float3> PaintHits;
RWStructuredBuffer<uint> PaintHitCount;
float4x4 canvasWorldToLocal;
float3 canvasLocalCenter;
float3 canvasLocalExtents;

float surfaceTension; 

uint GetHash(float3 pos) {
    int3 cell = (int3)floor((pos + float3(10000.0, 10000.0, 10000.0)) / cellSize);
    uint3 wrapped = (uint3)(cell & (HASH_DIM - 1));
    return wrapped.x + (wrapped.y * HASH_DIM) + (wrapped.z * HASH_DIM * HASH_DIM);
}

[numthreads(256, 1, 1)]
void CSClearGrid(uint3 id : SV_DispatchThreadID) {
    if (id.x >= 262144) return;
    GridCellStarts[id.x] = 0xFFFFFFFF;
    GridCellEnds[id.x] = 0xFFFFFFFF;
}

[numthreads(256, 1, 1)]
void CSGenerateKeyValues(uint3 id : SV_DispatchThreadID) {
    if (id.x >= sortedSize) return;

    if (id.x < numParticles && Particles[id.x].lifetime > 0.0) {
        uint hash = GetHash(Particles[id.x].position);
        GridKeyValues[id.x] = uint2(hash, id.x);
    } else {
        GridKeyValues[id.x] = uint2(0xFFFFFFFF, id.x);
    }
}

groupshared uint2 shared_data[256];
[numthreads(256, 1, 1)]
void CSBitonicSortLocal(uint3 id : SV_DispatchThreadID, uint GI : SV_GroupIndex) {
    uint globalIdx = id.x;
    
    if (globalIdx >= sortedSize) {
        shared_data[GI] = uint2(0xFFFFFFFF, 0xFFFFFFFF);
    } else {
        shared_data[GI] = GridKeyValues[globalIdx];
    }
    GroupMemoryBarrierWithGroupSync();

    for (uint stage = 2; stage <= 256; stage <<= 1) {
        for (uint step = stage >> 1; step > 0; step >>= 1) {
            uint k = GI ^ step;
            if (k > GI) {
                uint2 valI = shared_data[GI];
                uint2 valJ = shared_data[k];
                bool direction = ((GI & stage) == 0);
                if ((valI.x > valJ.x) == direction) {
                    shared_data[GI] = valJ;
                    shared_data[k] = valI;
                }
            }
            GroupMemoryBarrierWithGroupSync();
        }
    }

    if (globalIdx < sortedSize) {
        GridKeyValues[globalIdx] = shared_data[GI];
    }
}

[numthreads(256, 1, 1)]
void CSBitonicSortGlobal(uint3 id : SV_DispatchThreadID) {
    uint i = id.x;
    if (i >= sortedSize) return;

    uint j = i ^ _BlockSize;
    if (j > i) {
        uint2 valI = GridKeyValues[i];
        uint2 valJ = GridKeyValues[j];

        bool direction = ((i & _Stage) == 0);
        if ((valI.x > valJ.x) == direction) {
            GridKeyValues[i] = valJ;
            GridKeyValues[j] = valI;
        }
    }
}

[numthreads(256, 1, 1)]
void CSReorderParticles(uint3 id : SV_DispatchThreadID) {
    if (id.x >= sortedSize) return;
    
    uint originalIndex = GridKeyValues[id.x].y;
    Particle p;
    if (originalIndex < numParticles) {
        p = Particles[originalIndex];
    } else {
        p.position = float3(99999.0, 99999.0, 99999.0);
        p.velocity = 0;
        p.force = 0;
        p.density = 0.01;
        p.pressure = 0;
        p.lifetime = 0;
    }
    ParticlesSorted[id.x] = p;
}

[numthreads(256, 1, 1)]
void CSBuildGridOffsets(uint3 id : SV_DispatchThreadID) {
    if (id.x >= sortedSize) return;

    uint currKey = GridKeyValues[id.x].x;
    if (currKey == 0xFFFFFFFF) return;

    if (id.x == 0) {
        GridCellStarts[currKey] = 0;
    } else {
        uint prevKey = GridKeyValues[id.x - 1].x;
        if (currKey != prevKey) {
            GridCellStarts[currKey] = id.x;
            if (prevKey != 0xFFFFFFFF) {
                GridCellEnds[prevKey] = id.x;
            }
        }
    }

    if (id.x == sortedSize - 1) {
        GridCellEnds[currKey] = sortedSize;
    } else {
        uint nextKey = GridKeyValues[id.x + 1].x;
        if (nextKey == 0xFFFFFFFF) {
            GridCellEnds[currKey] = id.x + 1;
        }
    }
}

[numthreads(256, 1, 1)]
void CSDensityPressure(uint3 id : SV_DispatchThreadID) {
    if (id.x >= numParticles || ParticlesSorted[id.x].lifetime <= 0) return;

    float3 posI = ParticlesSorted[id.x].position;
    float densitySum = 0.0;
    float h2 = smoothingRadius * smoothingRadius;

    int3 cellIndex = (int3)floor((posI + float3(10000.0, 10000.0, 10000.0)) / cellSize);

    for (int x = -1; x <= 1; x++) {
        for (int y = -1; y <= 1; y++) {
            for (int z = -1; z <= 1; z++) {
                uint3 wrapped = (uint3)((cellIndex + int3(x, y, z)) & (HASH_DIM - 1));
                uint hash = wrapped.x + (wrapped.y * HASH_DIM) + (wrapped.z * HASH_DIM * HASH_DIM);
                
                uint start = GridCellStarts[hash];
                if (start != 0xFFFFFFFF) {
                    uint end = GridCellEnds[hash];
                    for (uint k = start; k < end; k++) {
                        float3 diff = posI - ParticlesSorted[k].position;
                        float r2 = dot(diff, diff);

                        if (r2 < h2) {
                            float h2_minus_r2 = h2 - r2;
                            densitySum += particleMass * poly6 * (h2_minus_r2 * h2_minus_r2 * h2_minus_r2);
                        }
                    }
                }
            }
        }
    }

    ParticlesSorted[id.x].density = max(densitySum, restDensity * 0.1f);
    ParticlesSorted[id.x].pressure = max(0.0, gasConstant * (ParticlesSorted[id.x].density - restDensity));
}
[numthreads(256, 1, 1)]
void CSForces(uint3 id : SV_DispatchThreadID) {
    if (id.x >= numParticles || ParticlesSorted[id.x].lifetime <= 0) return;

    float3 posI = ParticlesSorted[id.x].position;
    float3 velI = ParticlesSorted[id.x].velocity;
    float3 localPos = mul(bucketWorldToLocal, float4(posI, 1.0)).xyz;

    if (localPos.y < -bucketHeightCS + 0.01f) {
        ParticlesSorted[id.x].force = -velI * 0.5f; 
        return;
    }

    float densI = ParticlesSorted[id.x].density;
    float presI = ParticlesSorted[id.x].pressure;

    float3 pressureForce = float3(0, 0, 0);
    float3 viscosityForce = float3(0, 0, 0);
    float3 cohesionForce = float3(0, 0, 0); 
    float h = smoothingRadius;
    float h2 = h * h;

    int3 cellIndex = (int3)floor((posI + float3(10000.0, 10000.0, 10000.0)) / cellSize);

    for (int x = -1; x <= 1; x++) {
        for (int y = -1; y <= 1; y++) {
            for (int z = -1; z <= 1; z++) {
                uint3 wrapped = (uint3)((cellIndex + int3(x, y, z)) & (HASH_DIM - 1));
                uint hash = wrapped.x + (wrapped.y * HASH_DIM) + (wrapped.z * HASH_DIM * HASH_DIM);
                
                uint start = GridCellStarts[hash];
                if (start != 0xFFFFFFFF) {
                    uint end = GridCellEnds[hash];
                    for (uint k = start; k < end; k++) {
                        if (id.x == k) continue; 
                        
                        float3 diff = posI - ParticlesSorted[k].position;
                        float r2 = dot(diff, diff);

                        if (r2 < h2 && r2 > 0.000001f) {
                            float r_inv = rsqrt(r2);
                            float r = r2 * r_inv;
                            float3 direction = diff * r_inv;

                            float densJ_clamped = max(ParticlesSorted[k].density, restDensity * 0.1f);
                            float h_minus_r = h - r;

                            float pForce = -particleMass * (presI + ParticlesSorted[k].pressure) / (2.0 * densJ_clamped);
                            float forceMag = pForce * spikyGrad * (h_minus_r * h_minus_r);
                            forceMag = clamp(forceMag, -10000.0f, 10000.0f); 
                            pressureForce += direction * forceMag;

                            float3 vDiff = ParticlesSorted[k].velocity - velI;
                            viscosityForce += vDiff * (viscosity * particleMass * viscLap * h_minus_r / densJ_clamped);

                            float cohesionStrength = surfaceTension * particleMass; 
                            cohesionForce -= direction * (cohesionStrength * (h_minus_r / h) * h_minus_r);
                        }
                    }
                }
            }
        }
    }

    ParticlesSorted[id.x].force = pressureForce + viscosityForce + cohesionForce;
}

[numthreads(256, 1, 1)]
void CSIntegrate(uint3 id : SV_DispatchThreadID) {
    if (id.x >= numParticles) return;
    
    Particle p = ParticlesSorted[id.x];
    if (p.lifetime <= 0) return;

    p.lifetime -= deltaTime;
    if (p.lifetime <= 0.0) {
        p.position = float3(99999.0f, 99999.0f, 99999.0f);
        p.velocity = float3(0.0f, 0.0f, 0.0f);
        p.force = float3(0.0f, 0.0f, 0.0f);
        p.density = 0.0f;
        p.pressure = 0.0f;
        p.lifetime = -1.0f;
        
        ParticlesSorted[id.x] = p;
        uint originalIndex = GridKeyValues[id.x].y;
        if (originalIndex < numParticles) {
            Particles[originalIndex] = p;
        }
        return;
    }

    float3 acceleration = (p.force / max(p.density, restDensity * 0.1f)) + gravity;
    p.velocity += acceleration * deltaTime;
    p.position += p.velocity * deltaTime;
    
    float floorY = boxCenter.y - (boxSize.y / 2.0) + particleRadius;
    if (p.position.y < floorY) {
        p.position.y = floorY;
        p.velocity.y = min(p.velocity.y, 0.0) * -0.05; 
        p.velocity.x *= 0.1; 
        p.velocity.z *= 0.1; 
    }

    float3 localPos = mul(bucketWorldToLocal, float4(p.position, 1.0)).xyz;
    
    if (localPos.y >= -bucketHeightCS) {
        uint c;
        InterlockedAdd(ParticlesInBucketCount[0], 1, c);
    }
    
    float safetyBuffer = max(0.015f, particleRadius * 2.0f);

    if (localPos.y >= -bucketHeightCS - safetyBuffer) {
        bool hitBoundary = false;
        float3 relativeWorldVel = p.velocity - bucketVelocity;
        float3 localVel = mul(bucketWorldToLocal, float4(relativeWorldVel, 0.0)).xyz;

        float distXZ = length(localPos.xz);
        float maxR = bucketRadiusCS - particleRadius;
        
        if (distXZ > maxR && localPos.y >= -bucketHeightCS) {
            float3 normalXZ = normalize(float3(localPos.x, 0, localPos.z));
            localPos.xz = normalXZ.xz * maxR;
            
            float velDot = dot(localVel, normalXZ);
            if (velDot > 0) {
                localVel -= normalXZ * velDot * (1.0 + boundaryDamping);
            }
            hitBoundary = true;
        }
        
        float topY = bucketHeightCS - particleRadius;
        if (localPos.y > topY) {
            localPos.y = topY;
            if (localVel.y > 0) localVel.y *= -boundaryDamping;
            hitBoundary = true;
        }

        float bottomY = -bucketHeightCS + particleRadius;
        if (localPos.y < bottomY && localPos.y >= -bucketHeightCS - safetyBuffer) {
            float distToHole = length(localPos.xz - holeLocalPos.xz);
            
            if (distToHole > (holeRadiusCS - particleRadius)) {
                localPos.y = bottomY;
                if (localVel.y < 0) {
                    localVel.y *= -boundaryDamping;
                }

                float3 dirToHole = normalize(float3(holeLocalPos.x - localPos.x, 0.0f, holeLocalPos.z - localPos.z));
                float funnelForce = 1.5f; 
                localVel.xz += dirToHole.xz * funnelForce * deltaTime;
                localVel.y -= 0.1f * deltaTime;

                hitBoundary = true;
            }
            else {
                localVel.xz *= 0.7f; 
                localVel.y = clamp(localVel.y, -1.8f, -0.1f); 
                hitBoundary = true;
            }
        }

        if (hitBoundary) {
            p.position = mul(bucketLocalToWorld, float4(localPos, 1.0)).xyz;
            p.velocity = mul(bucketLocalToWorld, float4(localVel, 0.0)).xyz + bucketVelocity;
        }
    }
    
    if (localPos.y < -bucketHeightCS && localPos.y > -bucketHeightCS - 1.5f) {
        float3 relativeWorldVel = p.velocity - bucketVelocity;
        float3 localVel = mul(bucketWorldToLocal, float4(relativeWorldVel, 0.0)).xyz;
        
        localVel.x *= 0.75f; 
        localVel.z *= 0.75f;
        
        p.velocity = mul(bucketLocalToWorld, float4(localVel, 0.0)).xyz + bucketVelocity;
    }

    float3 localCanvasPos = mul(canvasWorldToLocal, float4(p.position, 1.0)).xyz;
    float3 diff = abs(localCanvasPos - canvasLocalCenter);
    
    if (diff.x < canvasLocalExtents.x && diff.y < canvasLocalExtents.y && diff.z < canvasLocalExtents.z) {
        uint count;
        InterlockedAdd(PaintHitCount[0], 1, count);
        if (count < 256) {
            PaintHits[count] = p.position; 
        }
        
        p.lifetime = -1.0f; 
        p.position = float3(99999.0f, 99999.0f, 99999.0f); 
        p.velocity = float3(0.0f, 0.0f, 0.0f);
        p.force = float3(0.0f, 0.0f, 0.0f);
        p.density = 0.0f;
        p.pressure = 0.0f;
    }

    ParticlesSorted[id.x] = p;
    
    uint originalIndex = GridKeyValues[id.x].y;
    if (originalIndex < numParticles) {
        Particles[originalIndex] = p;
    }
}