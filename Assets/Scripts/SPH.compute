#pragma kernel CSClearGrid
#pragma kernel CSBuildGrid
#pragma kernel CSDensityPressure
#pragma kernel CSForces
#pragma kernel CSIntegrate
#pragma kernel CSGenerateDensityGrid

struct Particle {
    float3 position;
    float3 velocity;
    float3 force;
    float density;
    float pressure;
    float lifetime;
};

RWStructuredBuffer<Particle> Particles;
RWStructuredBuffer<uint> GridCounters;
RWStructuredBuffer<uint> GridCells;
RWTexture3D<float> DensityGrid;
uint densityGridRes;

#define HASH_DIM 128 
#define MAX_PARTICLES_PER_CELL 128

uint numParticles;
float smoothingRadius;
float restDensity;
float gasConstant;
float viscosity;
float particleMass;
float3 gravity;
float3 boxSize;
float3 boxCenter;
float boundaryDamping;
float particleRadius;
float deltaTime;
float poly6;
float spikyGrad;
float viscLap;
float cellSize;

float4x4 bucketWorldToLocal;
float4x4 bucketLocalToWorld;
float bucketRadiusCS;
float bucketHeightCS;
float holeRadiusCS;
float3 holeLocalPos;
float3 bucketVelocity;

RWStructuredBuffer<float3> PaintHits;
RWStructuredBuffer<uint> PaintHitCount;
float4x4 canvasWorldToLocal;
float3 canvasLocalCenter;
float3 canvasLocalExtents;

uint GetHash(float3 pos) {
    int3 cell = (int3)floor((pos + float3(10000.0, 10000.0, 10000.0)) / cellSize);
    uint3 wrapped = (uint3)(cell & (HASH_DIM - 1));
    return wrapped.x + (wrapped.y * HASH_DIM) + (wrapped.z * HASH_DIM * HASH_DIM);
}

[numthreads(256, 1, 1)]
void CSClearGrid(uint3 id : SV_DispatchThreadID) {
    if (id.x >= 2097152) return; 
    GridCounters[id.x] = 0;
}

[numthreads(256, 1, 1)]
void CSBuildGrid(uint3 id : SV_DispatchThreadID) {
    if (id.x >= numParticles || Particles[id.x].lifetime <= 0) return;

    uint hash = GetHash(Particles[id.x].position);
    uint count;
    
    InterlockedAdd(GridCounters[hash], 1, count);
    
    if (count < MAX_PARTICLES_PER_CELL) {
        GridCells[hash * MAX_PARTICLES_PER_CELL + count] = id.x;
    }
}

[numthreads(256, 1, 1)]
void CSDensityPressure(uint3 id : SV_DispatchThreadID) {
    if (id.x >= numParticles || Particles[id.x].lifetime <= 0) return;

    float3 posI = Particles[id.x].position;
    float densitySum = 0.0;
    float h2 = smoothingRadius * smoothingRadius;

    int3 cellIndex = (int3)floor((posI + float3(10000.0, 10000.0, 10000.0)) / cellSize);

    for (int x = -1; x <= 1; x++) {
        for (int y = -1; y <= 1; y++) {
            for (int z = -1; z <= 1; z++) {
                uint3 wrapped = (uint3)((cellIndex + int3(x, y, z)) & (HASH_DIM - 1));
                uint hash = wrapped.x + (wrapped.y * HASH_DIM) + (wrapped.z * HASH_DIM * HASH_DIM);
                
                uint count = min(GridCounters[hash], MAX_PARTICLES_PER_CELL);
                for (uint k = 0; k < count; k++) {
                    uint j = GridCells[hash * MAX_PARTICLES_PER_CELL + k];
                    
                    float3 diff = posI - Particles[j].position;
                    float r2 = dot(diff, diff);

                    if (r2 < h2) {
                        densitySum += particleMass * poly6 * pow(h2 - r2, 3);
                    }
                }
            }
        }
    }

    Particles[id.x].density = max(densitySum, 0.01);
    
    Particles[id.x].pressure = max(0.0, gasConstant * (Particles[id.x].density - restDensity));
}

[numthreads(256, 1, 1)]
void CSForces(uint3 id : SV_DispatchThreadID) {
    if (id.x >= numParticles || Particles[id.x].lifetime <= 0) return;

    float3 posI = Particles[id.x].position;
    float3 velI = Particles[id.x].velocity;
    float densI = Particles[id.x].density;
    float presI = Particles[id.x].pressure;

    float3 pressureForce = float3(0, 0, 0);
    float3 viscosityForce = float3(0, 0, 0);
    float h = smoothingRadius;
    float h2 = h * h;

    int3 cellIndex = (int3)floor((posI + float3(10000.0, 10000.0, 10000.0)) / cellSize);



    for (int x = -1; x <= 1; x++) {
        for (int y = -1; y <= 1; y++) {
            for (int z = -1; z <= 1; z++) {
                uint3 wrapped = (uint3)((cellIndex + int3(x, y, z)) & (HASH_DIM - 1));
                uint hash = wrapped.x + (wrapped.y * HASH_DIM) + (wrapped.z * HASH_DIM * HASH_DIM);
                
                uint count = min(GridCounters[hash], MAX_PARTICLES_PER_CELL);
                for (uint k = 0; k < count; k++) {
                    uint j = GridCells[hash * MAX_PARTICLES_PER_CELL + k];
                    
                    float3 diff = posI - Particles[j].position;
                    float r2 = dot(diff, diff);

                    if (r2 < h2 && r2 > 0.000001f) {
                        float r = sqrt(r2);
                        float3 direction = diff / r;

                        float densJ_clamped = max(Particles[j].density, 0.1f);

                        float pForce = -particleMass * (presI + Particles[j].pressure) / (2.0 * densJ_clamped);
                        pressureForce += direction * (pForce * spikyGrad * pow(h - r, 2));

                        float3 vDiff = Particles[j].velocity - velI;
                        viscosityForce += vDiff * (viscosity * particleMass * viscLap * (h - r) / densJ_clamped);
                    }
                }
            }
        }
    }

    Particles[id.x].force = pressureForce + viscosityForce;
}

[numthreads(256, 1, 1)]
void CSIntegrate(uint3 id : SV_DispatchThreadID) {
    if (id.x >= numParticles) return;

    Particle p = Particles[id.x];
    if (p.lifetime <= 0) return;

    float3 acceleration = (p.force / max(p.density, restDensity)) + gravity;
    p.velocity += acceleration * deltaTime;
    p.position += p.velocity * deltaTime;

    float floorY = boxCenter.y - (boxSize.y / 2.0) + particleRadius;
    if (p.position.y < floorY) {
        p.position.y = floorY;
        p.velocity.y *= -boundaryDamping;
        p.velocity.x *= 0.95;
        p.velocity.z *= 0.95;
    }

    float3 localPos = mul(bucketWorldToLocal, float4(p.position, 1.0)).xyz;
    
    float safetyBuffer = max(0.015f, particleRadius * 4.0f);


    if (localPos.y >= -bucketHeightCS - safetyBuffer)
    {
        bool hitBoundary = false;
        float3 relativeWorldVel = p.velocity - bucketVelocity;
        float3 localVel = mul(bucketWorldToLocal, float4(relativeWorldVel, 0.0)).xyz;

        float distXZ = length(localPos.xz);
        float maxR = bucketRadiusCS - particleRadius;
        if (distXZ > maxR) {
            float3 normalXZ = normalize(float3(localPos.x, 0, localPos.z));
            localPos.xz = normalXZ.xz * maxR;
            
            float velDot = dot(localVel, normalXZ);
            if (velDot > 0) {
                localVel -= normalXZ * velDot * (1.0 + boundaryDamping);
            }
            hitBoundary = true;
        }

        float topY = bucketHeightCS - particleRadius;
        if (localPos.y > topY) {
            localPos.y = topY;
            if (localVel.y > 0) {
                localVel.y *= -boundaryDamping;
            }
            hitBoundary = true;
        }

        float bottomY = -bucketHeightCS + particleRadius;
        if (localPos.y < bottomY && localPos.y >= -bucketHeightCS) 
        {
            float distToHole = length(localPos.xz - holeLocalPos.xz);
            if (distToHole > (holeRadiusCS - particleRadius)) 
            {
                localPos.y = bottomY;
                if (localVel.y < 0) {
                    localVel.y *= -boundaryDamping;
                }
                hitBoundary = true;
            }
        }

        if (hitBoundary) {
            p.position = mul(bucketLocalToWorld, float4(localPos, 1.0)).xyz;
            p.velocity = mul(bucketLocalToWorld, float4(localVel, 0.0)).xyz + bucketVelocity;
        }
    }

 
    if (localPos.y < -bucketHeightCS)
    {
        p.force = float3(0, 0, 0);

        
        p.velocity.x *= 0.85f;
        p.velocity.z *= 0.85f;
    }

    float3 localCanvasPos = mul(canvasWorldToLocal, float4(p.position, 1.0)).xyz;
    float3 diff = abs(localCanvasPos - canvasLocalCenter);
    
    if (diff.x < canvasLocalExtents.x && diff.y < canvasLocalExtents.y && diff.z < canvasLocalExtents.z) 
    {
        uint count;
        InterlockedAdd(PaintHitCount[0], 1, count);
        
        if (count < 64) {
            PaintHits[count] = p.position; 
        }
    }

    Particles[id.x] = p;
}
[numthreads(8, 8, 8)]
void CSGenerateDensityGrid(uint3 id : SV_DispatchThreadID) {
    if (id.x >= densityGridRes || id.y >= densityGridRes || id.z >= densityGridRes) return;

    float3 uvw = (float3)id / (float3)(densityGridRes - 1);
    float3 pos = (boxCenter - boxSize * 0.5) + uvw * boxSize;

    float density = 0.0;
    float h = smoothingRadius;
    float h2 = h * h;

    int3 cellIndex = (int3)floor((pos + float3(10000.0, 10000.0, 10000.0)) / cellSize);



    for (int x = -1; x <= 1; x++) {
        for (int y = -1; y <= 1; y++) {
            for (int z = -1; z <= 1; z++) {
                uint3 wrapped = (uint3)((cellIndex + int3(x, y, z)) & (HASH_DIM - 1));
                uint hash = wrapped.x + (wrapped.y * HASH_DIM) + (wrapped.z * HASH_DIM * HASH_DIM);
                
                uint count = min(GridCounters[hash], MAX_PARTICLES_PER_CELL);
                for (uint k = 0; k < count; k++) {
                    uint j = GridCells[hash * MAX_PARTICLES_PER_CELL + k];
                    
                    float3 diff = pos - Particles[j].position;
                    float r2 = dot(diff, diff);

                    if (r2 < h2) {
                        float r = sqrt(r2);
                        float influence = 1.0 - (r / h);
                        density += influence * influence * influence;
                    }
                }
            }
        }
    }

    DensityGrid[id] = density;
}