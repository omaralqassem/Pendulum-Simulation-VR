#pragma kernel HashParticles
#pragma kernel BitonicSort
#pragma kernel BuildGrid
#pragma kernel DensityPressure
#pragma kernel Forces
#pragma kernel Integrate
#pragma kernel EmitParticles
#pragma kernel ClearGrid

#define THREAD_GROUP_SIZE 256
#define PI 3.14159265359f

struct Particle
{
    float3 position;
    float3 velocity;
    float density;
    float pressure;
    float lifetime;
    uint active;
};

struct GridCell
{
    uint start;
    uint count;
};

RWStructuredBuffer<Particle> particles;
RWStructuredBuffer<uint> sortedIndices;
RWStructuredBuffer<uint> gridHashes;
RWStructuredBuffer<GridCell> gridCells;
RWStructuredBuffer<uint> sortingKeys;

StructuredBuffer<uint> srcKeys;
RWStructuredBuffer<uint> dstKeys;
StructuredBuffer<uint> srcIndices;
RWStructuredBuffer<uint> dstIndices;

int particleCount;
int gridResolution;
float smoothingLength;
float particleRadius;
float restDensity;
float gasConstant;
float viscosity;
float3 gravity;
float timeStep;
float damping;
float3 floorPosition;
float floorRestitution;
float3 boundaryPosition;
float boundaryRadius;
float boundaryRestitution;

int emitCount;
float3 emitPosition;
float3 emitVelocity;
int emitStartIndex;

int stage;
int step;

// Collision-free direct 3D cell hashing relative to simulation boundaries
int3 GetGridCoord(float3 pos)
{
    float3 size = boundaryRadius * 2.0;
    float3 minBounds = boundaryPosition - float3(boundaryRadius, boundaryRadius, boundaryRadius);
    float3 normPos = (pos - minBounds) / size;
    return clamp((int3)(normPos * (float)gridResolution), 0, gridResolution - 1);
}

uint GetGridHash(int3 coord)
{
    return (uint)(coord.x + coord.y * gridResolution + coord.z * gridResolution * gridResolution);
}

// Optimized SPH Kernels
float Poly6Kernel(float r, float h)
{
    if (r > h || r < 0.0) return 0.0;
    float h2 = h * h;
    float r2 = r * r;
    float x = h2 - r2;
    return (315.0 / (64.0 * PI * pow(h, 9))) * x * x * x;
}

float3 SpikyKernelGradient(float3 diff, float r, float h)
{
    if (r > h || r < 0.0001) return float3(0, 0, 0);
    float x = h - r;
    float coeff = -45.0 / (PI * pow(h, 6));
    return (coeff * x * x) * (diff / r);
}

float ViscosityKernelLaplacian(float r, float h)
{
    if (r > h) return 0.0;
    return (45.0 / (PI * pow(h, 6))) * (h - r);
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void HashParticles(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= (uint)particleCount) return;

    sortedIndices[i] = i;

    Particle p = particles[i];
    if (p.active == 0)
    {
        gridHashes[i] = 0xFFFFFFFF;
        sortingKeys[i] = 0xFFFFFFFF;
        return;
    }

    int3 coord = GetGridCoord(p.position);
    uint hash = GetGridHash(coord);
    gridHashes[i] = hash;
    sortingKeys[i] = hash;
}

[numthreads(512, 1, 1)]
void BitonicSort(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= (uint)particleCount) return;

    uint posB = i ^ (1u << step);

    uint keyA = srcKeys[i];
    uint keyB = srcKeys[posB];
    uint idxA = srcIndices[i];
    uint idxB = srcIndices[posB];

    bool isLower = i < posB;
    bool shouldSwap = (keyA > keyB) == ((i & (1u << stage)) == 0);

    // Double buffering ensures safe, race-free global memory updates
    if (shouldSwap)
    {
        dstKeys[i] = isLower ? keyB : keyA;
        dstIndices[i] = isLower ? idxB : idxA;
    }
    else
    {
        dstKeys[i] = isLower ? keyA : keyB;
        dstIndices[i] = isLower ? idxA : idxB;
    }
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void BuildGrid(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= (uint)particleCount) return;

    uint idx = sortedIndices[i];
    uint hash = gridHashes[idx];

    if (hash == 0xFFFFFFFF) return;

    if (i == 0 || gridHashes[sortedIndices[i - 1]] != hash)
    {
        gridCells[hash].start = i;
    }

    if (i == (uint)particleCount - 1 || gridHashes[sortedIndices[i + 1]] != hash)
    {
        gridCells[hash].count = i - gridCells[hash].start + 1;
    }
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void DensityPressure(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= (uint)particleCount) return;

    uint idx = sortedIndices[i];
    Particle p = particles[idx];

    if (p.active == 0) return;

    float density = 0.0;
    float h = smoothingLength;
    int3 coord = GetGridCoord(p.position);
    
    for (int dx = -1; dx <= 1; dx++)
    {
        for (int dy = -1; dy <= 1; dy++)
        {
            for (int dz = -1; dz <= 1; dz++)
            {
                int3 nCoord = coord + int3(dx, dy, dz);
                // Grid bounds check
                if(nCoord.x < 0 || nCoord.x >= gridResolution ||
                   nCoord.y < 0 || nCoord.y >= gridResolution ||
                   nCoord.z < 0 || nCoord.z >= gridResolution) continue;

                uint neighborHash = GetGridHash(nCoord);
                GridCell cell = gridCells[neighborHash];

                for (uint j = cell.start; j < cell.start + cell.count; j++)
                {
                    uint nIdx = sortedIndices[j];
                    Particle pNeighbor = particles[nIdx];
                    if (pNeighbor.active == 0) continue;

                    float3 diff = p.position - pNeighbor.position;
                    float r = length(diff);
                    density += Poly6Kernel(r, h);
                }
            }
        }
    }

    particles[idx].density = max(density, restDensity);
    particles[idx].pressure = gasConstant * (particles[idx].density - restDensity);
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void Forces(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= (uint)particleCount) return;

    uint idx = sortedIndices[i];
    Particle p = particles[idx];
    if (p.active == 0) return;

    float3 pressureForce = float3(0, 0, 0);
    float3 viscosityForce = float3(0, 0, 0);
    float h = smoothingLength;

    int3 coord = GetGridCoord(p.position);

    for (int dx = -1; dx <= 1; dx++)
    {
        for (int dy = -1; dy <= 1; dy++)
        {
            for (int dz = -1; dz <= 1; dz++)
            {
                int3 nCoord = coord + int3(dx, dy, dz);
                if(nCoord.x < 0 || nCoord.x >= gridResolution ||
                   nCoord.y < 0 || nCoord.y >= gridResolution ||
                   nCoord.z < 0 || nCoord.z >= gridResolution) continue;

                GridCell cell = gridCells[GetGridHash(nCoord)];
                for (uint j = cell.start; j < cell.start + cell.count; j++)
                {
                    uint nIdx = sortedIndices[j];
                    if (idx == nIdx) continue;

                    Particle pNeighbor = particles[nIdx];
                    if (pNeighbor.active == 0) continue;

                    float3 diff = p.position - pNeighbor.position;
                    float r = length(diff);
                    if (r > 0.0 && r < h)
                    {
                        // Symmetric momentum conserving pressure gradient force
                        pressureForce -= (p.pressure / (p.density * p.density) + pNeighbor.pressure / (pNeighbor.density * pNeighbor.density)) 
                                         * SpikyKernelGradient(diff, r, h) * restDensity;

                        viscosityForce += viscosity * (pNeighbor.velocity - p.velocity) / pNeighbor.density * ViscosityKernelLaplacian(r, h);
                    }
                }
            }
        }
    }

    particles[idx].velocity += (pressureForce + viscosityForce) * timeStep;
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void Integrate(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= (uint)particleCount) return;

    if (particles[i].active == 0) return;

    particles[i].velocity += gravity * timeStep;
    particles[i].velocity *= damping;
    particles[i].position += particles[i].velocity * timeStep;

    // Stable boundary projection - Floor
    if (particles[i].position.y < floorPosition.y + particleRadius)
    {
        particles[i].position.y = floorPosition.y + particleRadius;
        if (particles[i].velocity.y < 0.0)
        {
            particles[i].velocity.y *= -floorRestitution;
        }
    }

    // Stable boundary projection - Spherical Boundary Container
    float3 relPos = particles[i].position - boundaryPosition;
    float dist = length(relPos);
    float maxDist = boundaryRadius - particleRadius;
    if (dist > maxDist)
    {
        float3 norm = relPos / dist;
        particles[i].position = boundaryPosition + norm * maxDist;
        
        float vDotN = dot(particles[i].velocity, norm);
        if (vDotN > 0.0)
        {
            particles[i].velocity -= (1.0 + boundaryRestitution) * vDotN * norm;
        }
    }
}

[numthreads(64, 1, 1)]
void EmitParticles(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)emitCount) return;
    
    uint index = (emitStartIndex + id.x) % particleCount;
    
    particles[index].position = emitPosition + (float3((id.x % 3) - 1, (id.x % 2) - 1, (id.x % 5) - 2) * 0.005);
    particles[index].velocity = emitVelocity;
    particles[index].active = 1;
    particles[index].lifetime = 0.0;
    particles[index].density = restDensity;
    particles[index].pressure = 0.0;
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void ClearGrid(uint3 id : SV_DispatchThreadID)
{
    uint numCells = (uint)(gridResolution * gridResolution * gridResolution);
    if (id.x >= numCells) return;
    gridCells[id.x].start = 0;
    gridCells[id.x].count = 0;
}