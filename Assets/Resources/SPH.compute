#pragma kernel ClearGrid
#pragma kernel HashParticles
#pragma kernel BitonicSortStep
#pragma kernel BuildGridIndices
#pragma kernel CalculateDensityPressure
#pragma kernel CalculateForces
#pragma kernel Integrate

struct Particle
{
    float3 position;
    float3 velocity;
    float3 force;
    float density;
    float pressure;
    int isActive;
};

struct GridCell
{
    int startIndex;
    int endIndex;
};

// Buffers
RWStructuredBuffer<Particle> particles;
RWStructuredBuffer<uint2> particleHashes; // x = hash, y = original index
RWStructuredBuffer<GridCell> grid;

// Parameters
cbuffer Params
{
    int maxParticles;
    int activeParticles;
    float deltaTime;
    float smoothingLength;
    float smoothingLengthSq;
    float particleMass;
    float restDensity;
    float gasConstant;
    float viscosity;
    float particleRadius;
    float boundaryDamping;
    float3 gravity;
    float3 boundaryMin;
    float3 boundaryMax;
    int3 gridDimensions;
    float cellSize;
    int bitonicBlockSize;
    int bitonicStepSize;
};

#define PI 3.14159265359

float Poly6Kernel(float rSq)
{
    if (rSq >= smoothingLengthSq) return 0.0;
    float diff = smoothingLengthSq - rSq;
    return 315.0 / (64.0 * PI * pow(smoothingLength, 9.0)) * diff * diff * diff;
}

float3 SpikyGradient(float3 r, float rLen)
{
    if (rLen >= smoothingLength || rLen < 0.0001) return float3(0, 0, 0);
    float diff = smoothingLength - rLen;
    return -45.0 / (PI * pow(smoothingLength, 6.0)) * diff * diff * (r / rLen);
}

float ViscosityLaplacian(float rLen)
{
    if (rLen >= smoothingLength) return 0.0;
    return 45.0 / (PI * pow(smoothingLength, 6.0)) * (smoothingLength - rLen);
}

int GridHash(int3 gridPos)
{
    const int p1 = 73856093;
    const int p2 = 19349663;
    const int p3 = 83492791;
    
    gridPos = clamp(gridPos, int3(0, 0, 0), gridDimensions - 1);
    int hash = (gridPos.x * p1) ^ (gridPos.y * p2) ^ (gridPos.z * p3);
    int gridSize = gridDimensions.x * gridDimensions.y * gridDimensions.z;
    return abs(hash) % gridSize;
}

int3 GetGridPosition(float3 worldPos)
{
    float3 relativePos = (worldPos - boundaryMin) / cellSize;
    return int3(floor(relativePos));
}

[numthreads(256, 1, 1)]
void ClearGrid(uint3 id : SV_DispatchThreadID)
{
    int gridSize = gridDimensions.x * gridDimensions.y * gridDimensions.z;
    if (id.x >= gridSize) return;
    
    grid[id.x].startIndex = -1;
    grid[id.x].endIndex = -1;
}

[numthreads(256, 1, 1)]
void HashParticles(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= maxParticles) return;
    
    if (particles[id.x].isActive == 1)
    {
        int3 gridPos = GetGridPosition(particles[id.x].position);
        uint hash = GridHash(gridPos);
        particleHashes[id.x] = uint2(hash, id.x);
    }
    else
    {
        particleHashes[id.x] = uint2(0xFFFFFFFF, id.x); // Inactive particles to end
    }
}

[numthreads(256, 1, 1)]
void BitonicSortStep(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= maxParticles) return;
    
    uint j = i ^ bitonicStepSize;
    
    if (j > i)
    {
        uint2 keyA = particleHashes[i];
        uint2 keyB = particleHashes[j];
        
        bool ascending = ((i & bitonicBlockSize) == 0);
        
        if ((keyA.x > keyB.x) == ascending)
        {
            particleHashes[i] = keyB;
            particleHashes[j] = keyA;
        }
    }
}

[numthreads(256, 1, 1)]
void BuildGridIndices(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= maxParticles) return;
    
    uint hash = particleHashes[id.x].x;
    if (hash == 0xFFFFFFFF) return; 
    
    uint prevHash = (id.x == 0) ? 0xFFFFFFFF : particleHashes[id.x - 1].x;
    
    if (id.x == 0 || hash != prevHash)
    {
        grid[hash].startIndex = id.x;
        if (id.x > 0 && prevHash != 0xFFFFFFFF)
        {
            grid[prevHash].endIndex = id.x;
        }
    }
    
    if (id.x == maxParticles - 1 || particleHashes[id.x + 1].x == 0xFFFFFFFF)
    {
        grid[hash].endIndex = id.x + 1;
    }
}

[numthreads(256, 1, 1)]
void CalculateDensityPressure(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= maxParticles) return;
    
    uint originalIndex = particleHashes[id.x].y;
    if (particles[originalIndex].isActive == 0) return;
    
    float3 pos = particles[originalIndex].position;
    float density = 0.0;
    
    int3 gridPos = GetGridPosition(pos);
    
    for (int z = -1; z <= 1; z++)
    {
        for (int y = -1; y <= 1; y++)
        {
            for (int x = -1; x <= 1; x++)
            {
                int3 neighborGrid = gridPos + int3(x, y, z);
                if (any(neighborGrid < 0) || any(neighborGrid >= gridDimensions)) continue;
                
                int hash = GridHash(neighborGrid);
                int start = grid[hash].startIndex;
                int end = grid[hash].endIndex;
                
                if (start == -1) continue;
                
                for (int i = start; i < end; i++)
                {
                    uint neighborOriginalIndex = particleHashes[i].y;
                    if (particles[neighborOriginalIndex].isActive == 0) continue;
                    
                    float3 neighborPos = particles[neighborOriginalIndex].position;
                    float3 diff = pos - neighborPos;
                    float rSq = dot(diff, diff);
                    
                    if (rSq < smoothingLengthSq)
                    {
                        density += particleMass * Poly6Kernel(rSq);
                    }
                }
            }
        }
    }
    
    particles[originalIndex].density = max(density, restDensity);
    particles[originalIndex].pressure = gasConstant * (particles[originalIndex].density - restDensity);
}

[numthreads(256, 1, 1)]
void CalculateForces(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= maxParticles) return;
    
    uint originalIndex = particleHashes[id.x].y;
    if (particles[originalIndex].isActive == 0) return;
    
    float3 pos = particles[originalIndex].position;
    float3 vel = particles[originalIndex].velocity;
    float density = particles[originalIndex].density;
    float pressure = particles[originalIndex].pressure;
    
    float3 pressureForce = float3(0, 0, 0);
    float3 viscosityForce = float3(0, 0, 0);
    
    int3 gridPos = GetGridPosition(pos);
    
    for (int z = -1; z <= 1; z++)
    {
        for (int y = -1; y <= 1; y++)
        {
            for (int x = -1; x <= 1; x++)
            {
                int3 neighborGrid = gridPos + int3(x, y, z);
                if (any(neighborGrid < 0) || any(neighborGrid >= gridDimensions)) continue;
                
                int hash = GridHash(neighborGrid);
                int start = grid[hash].startIndex;
                int end = grid[hash].endIndex;
                
                if (start == -1) continue;
                
                for (int i = start; i < end; i++)
                {
                    uint neighborOriginalIndex = particleHashes[i].y;
                    if (neighborOriginalIndex == originalIndex) continue;
                    if (particles[neighborOriginalIndex].isActive == 0) continue;
                    
                    float3 neighborPos = particles[neighborOriginalIndex].position;
                    float3 neighborVel = particles[neighborOriginalIndex].velocity;
                    float neighborDensity = particles[neighborOriginalIndex].density;
                    float neighborPressure = particles[neighborOriginalIndex].pressure;
                    
                    float3 diff = pos - neighborPos;
                    float rLen = length(diff);
                    
                    if (rLen < smoothingLength && rLen > 0.0001)
                    {
                        pressureForce += -particleMass * (pressure / (density * density) + 
                                        neighborPressure / (neighborDensity * neighborDensity)) * 
                                        SpikyGradient(diff, rLen);
                        
                        viscosityForce += viscosity * particleMass * 
                                         (neighborVel - vel) / neighborDensity * 
                                         ViscosityLaplacian(rLen);
                    }
                }
            }
        }
    }
    
    float3 gravityForce = gravity * density;
    particles[originalIndex].force = (pressureForce + viscosityForce + gravityForce);
}

[numthreads(256, 1, 1)]
void Integrate(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= maxParticles) return;
    if (particles[id.x].isActive == 0) return;
    
    float3 acceleration = particles[id.x].force / particles[id.x].density;
    particles[id.x].velocity += acceleration * deltaTime;
    particles[id.x].position += particles[id.x].velocity * deltaTime;
    
    float3 pos = particles[id.x].position;
    float3 vel = particles[id.x].velocity;
    
    if (pos.x < boundaryMin.x + particleRadius)
    {
        pos.x = boundaryMin.x + particleRadius;
        vel.x *= -boundaryDamping;
    }
    else if (pos.x > boundaryMax.x - particleRadius)
    {
        pos.x = boundaryMax.x - particleRadius;
        vel.x *= -boundaryDamping;
    }
    
    if (pos.y < boundaryMin.y + particleRadius)
    {
        pos.y = boundaryMin.y + particleRadius;
        vel.y *= -boundaryDamping;
    }
    else if (pos.y > boundaryMax.y - particleRadius)
    {
        pos.y = boundaryMax.y - particleRadius;
        vel.y *= -boundaryDamping;
    }
    
    if (pos.z < boundaryMin.z + particleRadius)
    {
        pos.z = boundaryMin.z + particleRadius;
        vel.z *= -boundaryDamping;
    }
    else if (pos.z > boundaryMax.z - particleRadius)
    {
        pos.z = boundaryMax.z - particleRadius;
        vel.z *= -boundaryDamping;
    }
    
    particles[id.x].position = pos;
    particles[id.x].velocity = vel;
}